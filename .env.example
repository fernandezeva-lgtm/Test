# --- Auth.js (NextAuth v5) ---
# Genera uno con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=
# Credenciales OAuth de Google (https://console.cloud.google.com/apis/credentials)
# URI de redirección autorizada: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Permite entrar sin Google (solo desarrollo). Se activa también si faltan AUTH_GOOGLE_*.
DEMO_LOGIN=false

# --- Plaid (agregación bancaria) ---
# https://dashboard.plaid.com/developers/keys  — si se dejan vacías la app usa datos de demostración.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox

# --- Claude (agente financiero) ---
ANTHROPIC_API_KEY=
