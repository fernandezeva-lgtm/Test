# Copia este archivo a .env y añade AL MENOS una clave gratuita (o usa el modo demo sin claves).

# Groq (gratis, muy rápido): https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini (capa gratuita de AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter (modelos con sufijo :free): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama local (gratis, sin clave): https://ollama.com
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# Cualquier otro endpoint compatible con OpenAI (LM Studio, vLLM, Together, Mistral…)
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_LABEL=

# Proveedor por defecto: demo | groq | gemini | openrouter | ollama | custom
# (si no se indica, se usa el primero con clave y si no hay ninguna, "demo")
# LLM_PROVIDER=

# Puerto del backend (MCP en /mcp y API del chat)
# PORT=8787
